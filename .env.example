PORT=3007
AUTH_TOKEN=replace-with-a-long-random-secret
VAULT_DIR=/home/mephisto/ideavault
REPOS_DIR=/home/mephisto
# https://claude.ai is for the MCP endpoint (/mcp). If you're serving the
# graph UI (web/) from its own domain, add that origin too, comma-separated
# — e.g. https://claude.ai,https://ideavault.app-me.online
ALLOWED_ORIGINS=https://claude.ai

# Optional — enables github_search_code. Classic PAT, no special scopes needed.
# github.com -> Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=

# Optional — enables solana_get_mint_info / solana_get_token_price against a
# different RPC if the public endpoint is too rate-limited for your use.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional — one per bot, enables telegram_bot_info("<name>") and
# telegram_send_message("<name>", text). Copy the token from that bot's own
# repo .env; it's never sent back to the client.
# TELEGRAM_BOT_TOKEN_ALICETGBOT=
# TELEGRAM_BOT_TOKEN_TGGROWTH=

# Optional per bot — default chat id for telegram_send_message so callers
# don't have to pass chat_id every time. Get it by messaging the bot once
# from the target chat, then reading the numeric id off
# https://api.telegram.org/bot<token>/getUpdates.
# TELEGRAM_CHAT_ID_ALICETGBOT=
# TELEGRAM_CHAT_ID_TGGROWTH=

# Used by deploy/service-watchdog.sh (not the Node server) to alert on
# service failures -- a dedicated ops channel, kept separate from any
# product bot above so alerts aren't mixed into a bot your users also use.
# NOTIFY_TELEGRAM_BOT_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=
