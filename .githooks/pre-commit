#!/usr/bin/env bash
# Blocks a commit if staged changes look like they contain a real secret.
# Scoped to added lines only (git diff --cached -U0), so pre-existing lines
# elsewhere in a touched file don't trigger false positives.
set -euo pipefail

fail=0

# Any .env-shaped file being staged, except the documented example/sample.
while IFS= read -r -d '' f; do
  base="$(basename "$f")"
  if [[ "$base" == .env* && "$base" != ".env.example" && "$base" != ".env.sample" ]]; then
    echo "pre-commit: refusing to commit '$f' -- looks like a real env file, not a template." >&2
    fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

# Content patterns, scanned only over lines added by this commit.
declare -a patterns=(
  '-----BEGIN (RSA|EC|OPENSSH|DSA|PGP)? ?PRIVATE KEY-----'
  'AKIA[0-9A-Z]{16}'                                   # AWS access key id
  'gh[pousr]_[A-Za-z0-9]{36,}'                          # GitHub token
  'xox[baprs]-[A-Za-z0-9-]{10,}'                        # Slack token
  'AIza[0-9A-Za-z_-]{35}'                               # Google API key
  'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'  # JWT
  '(api|secret|access|auth|private)[_-]?(key|token|secret)[[:space:]]*[:=][[:space:]]*[\"'"'"'][A-Za-z0-9_/+=.-]{16,}[\"'"'"']'
)

diff_content="$(git diff --cached -U0 -- . ':(exclude)*.lock' ':(exclude)package-lock.json' || true)"
added_lines="$(printf '%s\n' "$diff_content" | grep -E '^\+' | grep -Ev '^\+\+\+' || true)"

if [[ -n "$added_lines" ]]; then
  for pat in "${patterns[@]}"; do
    hits="$(printf '%s\n' "$added_lines" | grep -EnI -e "$pat" || true)"
    if [[ -n "$hits" ]]; then
      echo "pre-commit: a staged line matches a secret-shaped pattern ($pat):" >&2
      printf '%s\n' "$hits" | sed 's/^/  /' >&2
      fail=1
    fi
  done
fi

if [[ "$fail" -ne 0 ]]; then
  echo "" >&2
  echo "Blocked. If this is a genuine false positive, fix the pattern in .githooks/pre-commit" >&2
  echo "rather than bypassing with --no-verify." >&2
  exit 1
fi

exit 0
